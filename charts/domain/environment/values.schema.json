{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["metadata", "spec"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "annotations"],
      "properties": {
        "name": {"type": "string", "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"},
        "annotations": {
          "type": "object",
          "required": [
            "contract-first-idp.github.io/scm-host",
            "contract-first-idp.github.io/domain-org",
            "contract-first-idp.github.io/domain-repo"
          ]
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["platformTarget", "groupId", "environments", "platform"],
      "properties": {
        "owner": {"type": "string"},
        "type": {
          "type": "string",
          "const": "contract-first-idp-target"
        },
        "platformTarget": {"type": "string", "minLength": 1},
        "groupId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "environments": {
          "type": "object",
          "required": ["order", "build", "definitions"],
          "properties": {
            "order": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
              }
            },
            "build": {
              "type": "string",
              "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
            },
            "definitions": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^([a-z][a-z0-9]*)(-[a-z0-9]+)*$"
              },
              "additionalProperties": {
                "type": "object",
                "required": ["namespaceSuffix"],
                "properties": {
                  "namespaceSuffix": {"type": "string"}
                },
                "additionalProperties": false
              }
            }
          }
        },
        "platform": {
          "type": "object",
          "required": ["target", "argocd", "cluster", "charts", "schemaRegistry", "services", "security", "spectralRules", "registry", "build"],
          "properties": {
            "target": {
              "type": "object",
              "required": ["name"],
              "properties": {"name": {"type": "string", "minLength": 1}}
            },
            "argocd": {
              "type": "object",
              "required": ["namespace", "destinationServer"]
            },
            "cluster": {
              "type": "object",
              "required": ["routerDomain"],
              "properties": {"routerDomain": {"type": "string", "minLength": 1}}
            },
            "charts": {
              "type": "object",
              "required": ["repositoryUrl", "revision"],
              "properties": {
                "repositoryUrl": {"type": "string", "format": "uri"},
                "revision": {"type": "string", "minLength": 1}
              }
            },
            "schemaRegistry": {
              "type": "object",
              "required": ["apiUrl", "authServerUrl"],
              "properties": {
                "apiUrl": {"type": "string", "format": "uri"},
                "uiUrl": {"type": "string", "format": "uri"},
                "authServerUrl": {"type": "string", "format": "uri"}
              },
              "additionalProperties": false
            },
            "services": {
              "type": "object",
              "required": ["microcks"],
              "properties": {
                "devSpaces": {"type": "object", "additionalProperties": true},
                "developerHub": {"type": "object", "additionalProperties": true},
                "keycloak": {"type": "object", "additionalProperties": true},
                "microcks": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {"url": {"type": "string", "format": "uri"}},
                  "additionalProperties": true
                },
                "hawtio": {"type": "object", "additionalProperties": true},
                "gitea": {"type": "object", "additionalProperties": true}
              },
              "additionalProperties": false
            },
            "security": {
              "type": "object",
              "required": ["keycloak", "secrets"],
              "properties": {
                "publisherIdentity": {"type": "object", "properties": {"enabled": {"type": "boolean", "default": true}}, "additionalProperties": false},
                "keycloak": {
                  "type": "object",
                  "required": ["namespace", "instanceName", "realm"],
                  "properties": {
                    "namespace": {"type": "string", "minLength": 1},
                    "instanceName": {"type": "string", "minLength": 1},
                    "realm": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                },
                "secrets": {
                  "type": "object",
                  "required": ["namespace"],
                  "properties": {"namespace": {"type": "string", "minLength": 1}},
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "spectralRules": {
              "type": "object",
              "required": ["repositoryUrl", "revision", "path"],
              "properties": {
                "repositoryUrl": {"type": "string", "format": "uri"},
                "revision": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1}
              }
            },
            "registry": {
              "type": "object",
              "required": ["quay"],
              "properties": {
                "quay": {
                  "type": "object",
                  "required": ["host", "clusterId", "credentials"],
                  "properties": {
                    "host": {"type": "string", "minLength": 1},
                    "clusterId": {"type": "string", "minLength": 1},
                    "credentials": {
                      "type": "object",
                      "required": ["sourcePullSecretName", "destinationPushSecretName", "runtimePullSecretName"]
                    }
                  }
                }
              }
            },
            "build": {
              "type": "object",
              "required": ["sourceRevision", "sccClusterRoleName", "deploymentUpdate"]
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
